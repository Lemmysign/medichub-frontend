# Built into the static bundle at build time (Vite only exposes VITE_-prefixed vars).
# Not a secret — just where the deployed frontend sends API calls, since it's on a
# different domain (portal.passmdcn.com) than the backend (portalapi.passmdcn.com)
# and there's no same-origin proxy in production like vite.config.ts provides in dev.
VITE_API_URL=https://portalapi.passmdcn.com/api
